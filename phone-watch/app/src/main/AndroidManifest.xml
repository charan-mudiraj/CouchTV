<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The lists, pictures and trailers; and updates: check GitHub, download the new APK and install it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Play on TV through CouchTV Remote, which takes titles only from apps signed with its key. Declared here too,
         so it's there whichever of the two apps is installed first. -->
    <permission
        android:name="com.couchtv.permission.PLAY_ON_TV"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.couchtv.permission.PLAY_ON_TV" />

    <!-- Android 11+ only lets the app see the remote when it asks for it. -->
    <queries>
        <package android:name="com.couchtv.remote" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CouchWatch">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- A title playing inside the app, in its website's player: turns with the phone, without starting again. -->
        <activity
            android:name=".PlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode"
            android:exported="false"
            android:screenOrientation="fullUser"
            android:theme="@style/Theme.CouchWatch.Player"
            android:windowSoftInputMode="adjustResize" />
        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />
    </application>
</manifest>
