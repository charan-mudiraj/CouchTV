<?xml version="1.0" encoding="utf-8"?>
<!--
    The remote fits the screen: nothing scrolls up or down. The top (how it reaches the TV, the TV's screen and sound
    here, power) and the dots at the bottom stay put; in between, pages swipe sideways like a phone's home screen.
    Flexible parts (the D-pad, the pointer pad, the grids) shrink or grow with the screen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

<!-- The remote -->
<LinearLayout
    android:id="@+id/main_ui"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- How it reaches the TV (icons; tap for the details), the TV's screen and sound on this phone, power -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/status_bg"
            android:clickable="true"
            android:contentDescription="@string/status_description"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:id="@+id/status_tv"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_tv" />

            <ImageView
                android:id="@+id/status_box"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_router" />

            <ImageView
                android:id="@+id/status_ir"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ir" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/settings_open"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/listen_bg"
            android:contentDescription="@string/settings_title"
            android:paddingBottom="4dp"
            android:src="@drawable/ic_settings"
            android:stateListAnimator="@animator/key_press"
            android:tooltipText="@string/settings_title" />

        <!-- The TV's screen here, to choose from across the room -->
        <ImageButton
            android:id="@+id/mirror"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/listen_bg"
            android:contentDescription="@string/mirror_start"
            android:paddingBottom="4dp"
            android:src="@drawable/ic_mirror"
            android:stateListAnimator="@animator/key_press"
            android:tooltipText="@string/mirror_start" />

        <ImageButton
            android:id="@+id/listen"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/listen_bg"
            android:contentDescription="@string/listen_start"
            android:paddingBottom="4dp"
            android:src="@drawable/ic_headphones"
            android:stateListAnimator="@animator/key_press"
            android:tooltipText="@string/listen_start" />

        <com.couchtv.remote.PowerButton
            android:id="@+id/power"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/power_bg"
            android:contentDescription="@string/power"
            android:paddingBottom="4dp"
            android:src="@drawable/ic_power"
            android:stateListAnimator="@animator/key_press" />
    </LinearLayout>

    <!-- After Power: what's happening, and how long until the TV listens to its power button again -->
    <TextView
        android:id="@+id/power_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/update_bg"
        android:padding="12dp"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Shown when a newer build is on GitHub -->
    <LinearLayout
        android:id="@+id/update_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/update_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/update_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <Button
            android:id="@+id/update_now"
            style="@style/RemoteKey.Text"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/update"
            android:textColor="@color/good" />
    </LinearLayout>

    <com.couchtv.remote.PagerView
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- 0. Suggestions from the TV: popular films and top songs, to play there (left of the remote) -->
            <LinearLayout style="@style/Page">

                <com.couchtv.remote.SuggestionsView
                    android:id="@+id/suggestions"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- 1. Remote: search, the D-pad and the keys as on a real remote, the apps at the bottom (where the app opens) -->
            <LinearLayout style="@style/Page">

                <!-- Search: the mic for voice search, or tap the bar to type -->
                <LinearLayout
                    android:id="@+id/search_bar"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="@drawable/search_bar_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_search" />

                    <TextView
                        android:id="@+id/search_hint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/search_hint"
                        android:textColor="@color/muted"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/voice_search"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/mic_bg"
                        android:contentDescription="@string/voice_search"
                        android:paddingStart="13dp"
                        android:paddingTop="11dp"
                        android:paddingEnd="13dp"
                        android:paddingBottom="15dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_mic"
                        android:stateListAnimator="@animator/key_press" />
                </LinearLayout>

                <!-- As big as the space left allows -->
                <com.couchtv.remote.DpadView
                    android:id="@+id/dpad"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:layout_weight="1" />

                <!-- Back, Home, Menu, Exit: round keys -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/back"
                        style="@style/RoundKey"
                        android:contentDescription="@string/back"
                        android:src="@drawable/ic_back"
                        android:tooltipText="@string/back" />

                    <ImageButton
                        android:id="@+id/home"
                        style="@style/RoundKey"
                        android:contentDescription="@string/home"
                        android:src="@drawable/ic_home"
                        android:tooltipText="@string/home" />

                    <ImageButton
                        android:id="@+id/menu"
                        style="@style/RoundKey"
                        android:contentDescription="@string/menu"
                        android:src="@drawable/ic_menu"
                        android:tooltipText="@string/menu" />

                    <ImageButton
                        android:id="@+id/exit"
                        style="@style/RoundKey"
                        android:contentDescription="@string/key_exit"
                        android:src="@drawable/ic_exit"
                        android:tooltipText="@string/key_exit" />
                </LinearLayout>

                <!-- The volume rocker; mute, play/pause, full screen, delete; and the sleep timer, tall like the rocker -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="64dp"
                        android:layout_height="136dp"
                        android:background="@drawable/key_bg"
                        android:orientation="vertical"
                        android:paddingBottom="4dp">

                        <ImageButton
                            android:id="@+id/volume_up"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:background="@drawable/rocker_half_bg"
                            android:contentDescription="@string/volume_up"
                            android:src="@drawable/ic_volume_up" />

                        <View
                            android:layout_width="24dp"
                            android:layout_height="1dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@color/key_edge" />

                        <ImageButton
                            android:id="@+id/volume_down"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:background="@drawable/rocker_half_bg"
                            android:contentDescription="@string/volume_down"
                            android:src="@drawable/ic_volume_down" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/mute"
                                style="@style/RoundKey"
                                android:contentDescription="@string/mute"
                                android:src="@drawable/ic_volume_off"
                                android:tooltipText="@string/mute" />

                            <ImageButton
                                android:id="@+id/play_pause"
                                style="@style/RoundKey"
                                android:contentDescription="@string/play_pause"
                                android:src="@drawable/ic_play_pause"
                                android:tooltipText="@string/play_pause" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/full_screen"
                                style="@style/RoundKey"
                                android:contentDescription="@string/key_full_screen"
                                android:src="@drawable/ic_fullscreen"
                                android:tooltipText="@string/key_full_screen" />

                            <ImageButton
                                android:id="@+id/delete"
                                style="@style/RoundKey"
                                android:contentDescription="@string/key_delete"
                                android:src="@drawable/ic_backspace"
                                android:tooltipText="@string/key_delete" />
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/sleep_timer"
                        style="@style/RemoteKey.Text"
                        android:layout_width="64dp"
                        android:layout_height="136dp"
                        android:drawableTop="@drawable/ic_bedtime"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/ink"
                        android:paddingTop="30dp"
                        android:paddingBottom="30dp"
                        android:text="@string/key_sleep_timer"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- The apps' own buttons, as on a real remote -->
                <com.couchtv.remote.FitGrid
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="6dp"
                    app:columns="3"
                    app:fillLastRow="true"
                    app:gap="8dp"
                    app:rowHeight="44dp">

                    <Button
                        android:id="@+id/app_netflix"
                        style="@style/AppPill"
                        android:backgroundTint="@color/netflix"
                        android:text="@string/app_netflix" />

                    <Button
                        android:id="@+id/app_youtube"
                        style="@style/AppPill"
                        android:backgroundTint="@color/youtube"
                        android:text="@string/app_youtube" />

                    <Button
                        android:id="@+id/app_prime"
                        style="@style/AppPill"
                        android:backgroundTint="@color/prime"
                        android:text="@string/app_prime" />

                    <Button
                        android:id="@+id/app_hotstar"
                        style="@style/AppPill"
                        android:backgroundTint="@color/hotstar"
                        android:text="@string/app_hotstar" />

                    <Button
                        android:id="@+id/app_web"
                        style="@style/AppPill"
                        android:backgroundTint="@color/web"
                        android:text="@string/app_web" />
                </com.couchtv.remote.FitGrid>
            </LinearLayout>

            <!-- 2. Trackpad, like a laptop's, with its two buttons -->
            <LinearLayout style="@style/Page">

                <com.couchtv.remote.TrackpadView
                    android:id="@+id/trackpad"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:layout_weight="1" />

                <!-- Hold one to drag with another finger on the pad -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-5dp"
                    android:layout_marginEnd="-5dp"
                    android:layout_marginBottom="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/left_click"
                        style="@style/RemoteKey.Text"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:text="@string/left_click" />

                    <Button
                        android:id="@+id/right_click"
                        style="@style/RemoteKey.Text"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:text="@string/right_click" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. A PC keyboard, and typing with this phone's own -->
            <LinearLayout
                style="@style/Page"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <!-- Type into the TV with this phone's own keyboard -->
                <TextView
                    android:id="@+id/keyboard_type"
                    style="@style/PageAction"
                    android:layout_marginEnd="14dp"
                    android:text="@string/keyboard_type" />

                <com.couchtv.remote.KeyboardView
                    android:id="@+id/keyboard"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="6dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/keyboard" />
            </LinearLayout>
        </LinearLayout>
    </com.couchtv.remote.PagerView>

    <com.couchtv.remote.PageDots
        android:id="@+id/dots"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginBottom="4dp" />
</LinearLayout>

<!-- The screen mirror: the TV's screen, full screen in landscape, with a few keys at the side -->
<FrameLayout
    android:id="@+id/mirror_layer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:visibility="gone">

    <com.couchtv.remote.MirrorView
        android:id="@+id/mirror_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/mirror_title" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="8dp"
        android:background="@drawable/strip_bg"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="6dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/mirror_back"
            style="@style/StripKey"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <ImageButton
            android:id="@+id/mirror_home"
            style="@style/StripKey"
            android:contentDescription="@string/home"
            android:src="@drawable/ic_home" />

        <ImageButton
            android:id="@+id/mirror_volume_down"
            style="@style/StripKey"
            android:contentDescription="@string/volume_down"
            android:src="@drawable/ic_volume_down" />

        <ImageButton
            android:id="@+id/mirror_volume_up"
            style="@style/StripKey"
            android:contentDescription="@string/volume_up"
            android:src="@drawable/ic_volume_up" />

        <ImageButton
            android:id="@+id/mirror_keyboard"
            style="@style/StripKey"
            android:contentDescription="@string/keyboard"
            android:src="@drawable/ic_keyboard" />

        <ImageButton
            android:id="@+id/mirror_exit"
            style="@style/StripKey"
            android:contentDescription="@string/mirror_exit"
            android:src="@drawable/ic_close" />
    </LinearLayout>
</FrameLayout>

<!-- Settings, a screen of its own over the remote (like a phone's Settings app) -->
<com.couchtv.remote.SettingsScreen
    android:id="@+id/settings_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />

<!-- Power with the TV on: a big countdown in the middle, as on the TV, with Cancel within easy reach -->
<FrameLayout
    android:id="@+id/power_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3000000"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/power_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/card_bg"
        android:clickable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="22dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <com.couchtv.remote.CountdownRing
            android:id="@+id/power_ring"
            android:layout_width="200dp"
            android:layout_height="200dp" />

        <TextView
            android:id="@+id/power_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/ink"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/power_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/power_cancel"
            style="@style/RemoteKey.Text"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:text="@string/power_cancel"
            android:textColor="@color/good"
            android:textSize="19sp" />

        <Button
            android:id="@+id/power_now"
            style="@style/RemoteKey.Text"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/power_now"
            android:textColor="@color/power" />
    </LinearLayout>
</FrameLayout>
</FrameLayout>
