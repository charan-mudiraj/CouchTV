<?xml version="1.0" encoding="utf-8"?>
<!--
    The remote fits the screen: nothing scrolls up or down. The top (status, the TV's sound here, power) and the dots
    at the bottom stay put; in between, pages swipe sideways like a phone's home screen. Flexible parts (the D-pad,
    the pointer pad, the grids) shrink or grow with the screen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

<!-- The remote -->
<LinearLayout
    android:id="@+id/main_ui"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Title, status, the TV's sound on this phone, power -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/title"
                android:textColor="@color/ink"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- The TV's screen here, to choose from across the room -->
        <ImageButton
            android:id="@+id/mirror"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/listen_bg"
            android:contentDescription="@string/mirror_start"
            android:paddingBottom="4dp"
            android:src="@drawable/ic_mirror"
            android:stateListAnimator="@animator/key_press"
            android:tooltipText="@string/mirror_start" />

        <ImageButton
            android:id="@+id/listen"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/listen_bg"
            android:contentDescription="@string/listen_start"
            android:paddingBottom="4dp"
            android:src="@drawable/ic_headphones"
            android:stateListAnimator="@animator/key_press"
            android:tooltipText="@string/listen_start" />

        <ImageButton
            android:id="@+id/power"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/power_bg"
            android:contentDescription="@string/power"
            android:paddingBottom="4dp"
            android:src="@drawable/ic_power"
            android:stateListAnimator="@animator/key_press" />
    </LinearLayout>

    <!-- Shown when a newer build is on GitHub -->
    <LinearLayout
        android:id="@+id/update_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/update_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/update_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <Button
            android:id="@+id/update_now"
            style="@style/RemoteKey.Text"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/update"
            android:textColor="@color/good" />
    </LinearLayout>

    <com.couchtv.remote.PagerView
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- 0. Suggestions from the TV: popular films and top songs, to play there (left of the remote) -->
            <LinearLayout style="@style/Page">

                <com.couchtv.remote.SuggestionsView
                    android:id="@+id/suggestions"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- 1. Remote: search, D-pad, the everyday keys (where the app opens) -->
            <LinearLayout style="@style/Page">

                <!-- Search: the mic for voice search, or tap the bar to type -->
                <LinearLayout
                    android:id="@+id/search_bar"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="@drawable/search_bar_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_search" />

                    <TextView
                        android:id="@+id/search_hint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/search_hint"
                        android:textColor="@color/muted"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/voice_search"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/mic_bg"
                        android:contentDescription="@string/voice_search"
                        android:paddingStart="13dp"
                        android:paddingTop="11dp"
                        android:paddingEnd="13dp"
                        android:paddingBottom="15dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_mic"
                        android:stateListAnimator="@animator/key_press" />
                </LinearLayout>

                <!-- As big as the space left allows -->
                <com.couchtv.remote.DpadView
                    android:id="@+id/dpad"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:layout_weight="1" />

                <!-- Back, Home, Menu -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-5dp"
                    android:layout_marginEnd="-5dp"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/back"
                        style="@style/RemoteKey"
                        android:layout_height="60dp"
                        android:contentDescription="@string/back"
                        android:src="@drawable/ic_back" />

                    <ImageButton
                        android:id="@+id/home"
                        style="@style/RemoteKey"
                        android:layout_height="60dp"
                        android:contentDescription="@string/home"
                        android:src="@drawable/ic_home" />

                    <ImageButton
                        android:id="@+id/menu"
                        style="@style/RemoteKey"
                        android:layout_height="60dp"
                        android:contentDescription="@string/menu"
                        android:src="@drawable/ic_menu" />
                </LinearLayout>

                <!-- Volume and play/pause -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-5dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="-5dp"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/volume_down"
                        style="@style/RemoteKey"
                        android:layout_height="60dp"
                        android:contentDescription="@string/volume_down"
                        android:src="@drawable/ic_volume_down" />

                    <ImageButton
                        android:id="@+id/mute"
                        style="@style/RemoteKey"
                        android:layout_height="60dp"
                        android:contentDescription="@string/mute"
                        android:src="@drawable/ic_volume_off" />

                    <ImageButton
                        android:id="@+id/volume_up"
                        style="@style/RemoteKey"
                        android:layout_height="60dp"
                        android:contentDescription="@string/volume_up"
                        android:src="@drawable/ic_volume_up" />

                    <ImageButton
                        android:id="@+id/play_pause"
                        style="@style/RemoteKey"
                        android:layout_height="60dp"
                        android:contentDescription="@string/play_pause"
                        android:src="@drawable/ic_play_pause" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. Apps, and the TV's other keys -->
            <LinearLayout style="@style/Page">

                <TextView
                    style="@style/PageTitle"
                    android:text="@string/apps" />

                <com.couchtv.remote.FitGrid
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    app:columns="2"
                    app:fillLastRow="true"
                    app:gap="12dp"
                    app:rowHeight="96dp">

                    <Button
                        android:id="@+id/app_netflix"
                        style="@style/AppTile"
                        android:backgroundTint="@color/netflix"
                        android:text="@string/app_netflix" />

                    <Button
                        android:id="@+id/app_youtube"
                        style="@style/AppTile"
                        android:backgroundTint="@color/youtube"
                        android:text="@string/app_youtube" />

                    <Button
                        android:id="@+id/app_prime"
                        style="@style/AppTile"
                        android:backgroundTint="@color/prime"
                        android:text="@string/app_prime" />

                    <Button
                        android:id="@+id/app_hotstar"
                        style="@style/AppTile"
                        android:backgroundTint="@color/hotstar"
                        android:text="@string/app_hotstar" />

                    <Button
                        android:id="@+id/app_web"
                        style="@style/AppTile"
                        android:backgroundTint="@color/web"
                        android:text="@string/app_web" />
                </com.couchtv.remote.FitGrid>

                <TextView
                    style="@style/Section"
                    android:layout_marginTop="12dp"
                    android:text="@string/tv_keys" />

                <com.couchtv.remote.FitGrid
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    app:columns="2"
                    app:gap="10dp"
                    app:rowHeight="56dp">

                    <Button
                        android:id="@+id/exit"
                        style="@style/RemoteKey.Text"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:text="@string/key_exit" />

                    <Button
                        android:id="@+id/full_screen"
                        style="@style/RemoteKey.Text"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:text="@string/key_full_screen" />

                    <Button
                        android:id="@+id/sleep_timer"
                        style="@style/RemoteKey.Text"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:text="@string/key_sleep_timer" />

                    <Button
                        android:id="@+id/delete"
                        style="@style/RemoteKey.Text"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:text="@string/key_delete" />
                </com.couchtv.remote.FitGrid>
            </LinearLayout>

            <!-- 3. Trackpad, like a laptop's, with its two buttons -->
            <LinearLayout style="@style/Page">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/PageTitle"
                        android:layout_width="0dp"
                        android:layout_marginBottom="0dp"
                        android:layout_weight="1"
                        android:text="@string/trackpad" />

                    <!-- The TV pointer's look -->
                    <TextView
                        android:id="@+id/pointer_look"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:padding="10dp"
                        android:text="@string/pointer_look"
                        android:textColor="@color/good"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/trackpad_help"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <com.couchtv.remote.TrackpadView
                    android:id="@+id/trackpad"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:layout_weight="1" />

                <!-- Hold one to drag with another finger on the pad -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-5dp"
                    android:layout_marginEnd="-5dp"
                    android:layout_marginBottom="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/left_click"
                        style="@style/RemoteKey.Text"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:text="@string/left_click" />

                    <Button
                        android:id="@+id/right_click"
                        style="@style/RemoteKey.Text"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:text="@string/right_click" />
                </LinearLayout>
            </LinearLayout>

            <!-- 4. A PC keyboard, and typing with this phone's own -->
            <LinearLayout
                style="@style/Page"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="4dp">

                    <TextView
                        style="@style/PageTitle"
                        android:layout_width="0dp"
                        android:layout_marginBottom="0dp"
                        android:layout_weight="1"
                        android:text="@string/keyboard" />

                    <!-- Type into the TV with this phone's own keyboard -->
                    <TextView
                        android:id="@+id/keyboard_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:padding="10dp"
                        android:text="@string/keyboard_type"
                        android:textColor="@color/good"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/keyboard_help"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <com.couchtv.remote.KeyboardView
                    android:id="@+id/keyboard"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="6dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/keyboard" />
            </LinearLayout>

            <!-- 5. Your own buttons, and the app's version -->
            <LinearLayout style="@style/Page">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/PageTitle"
                        android:layout_width="0dp"
                        android:layout_marginBottom="0dp"
                        android:layout_weight="1"
                        android:text="@string/my_buttons" />

                    <TextView
                        android:id="@+id/edit_buttons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:padding="10dp"
                        android:text="@string/edit"
                        android:textColor="@color/good"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/my_buttons_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/my_buttons_empty"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <!-- Rows get shorter as buttons are added, so they always fit -->
                <com.couchtv.remote.FitGrid
                    android:id="@+id/my_buttons"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    app:columns="3"
                    app:gap="8dp"
                    app:rowHeight="60dp" />

                <Button
                    android:id="@+id/add_button"
                    style="@style/RemoteKey.Text"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/add_button_label"
                    android:textColor="@color/good" />

                <TextView
                    android:id="@+id/version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:padding="8dp"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </com.couchtv.remote.PagerView>

    <com.couchtv.remote.PageDots
        android:id="@+id/dots"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginBottom="4dp" />
</LinearLayout>

<!-- The screen mirror: the TV's screen, full screen in landscape, with a few keys at the side -->
<FrameLayout
    android:id="@+id/mirror_layer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:visibility="gone">

    <com.couchtv.remote.MirrorView
        android:id="@+id/mirror_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/mirror_title" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="8dp"
        android:background="@drawable/strip_bg"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="6dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/mirror_back"
            style="@style/StripKey"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <ImageButton
            android:id="@+id/mirror_home"
            style="@style/StripKey"
            android:contentDescription="@string/home"
            android:src="@drawable/ic_home" />

        <ImageButton
            android:id="@+id/mirror_volume_down"
            style="@style/StripKey"
            android:contentDescription="@string/volume_down"
            android:src="@drawable/ic_volume_down" />

        <ImageButton
            android:id="@+id/mirror_volume_up"
            style="@style/StripKey"
            android:contentDescription="@string/volume_up"
            android:src="@drawable/ic_volume_up" />

        <ImageButton
            android:id="@+id/mirror_keyboard"
            style="@style/StripKey"
            android:contentDescription="@string/keyboard"
            android:src="@drawable/ic_keyboard" />

        <ImageButton
            android:id="@+id/mirror_exit"
            style="@style/StripKey"
            android:contentDescription="@string/mirror_exit"
            android:src="@drawable/ic_close" />
    </LinearLayout>
</FrameLayout>
</FrameLayout>
