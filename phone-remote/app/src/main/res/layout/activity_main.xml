<?xml version="1.0" encoding="utf-8"?>
<!--
    The remote fits the screen: nothing scrolls up or down. The top (how it reaches the TV, the TV's screen and sound
    here, power) and the dots at the bottom stay put; in between, pages swipe sideways like a phone's home screen.
    Flexible parts (the D-pad, the keyboard) shrink or grow with the screen. The trackpad is a dialog over it all.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

<!-- The remote -->
<LinearLayout
    android:id="@+id/main_ui"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- How it reaches the TV (icons; tap for the details), the TV's screen and sound on this phone, power -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/status_bg"
            android:clickable="true"
            android:contentDescription="@string/status_description"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:id="@+id/status_tv"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_tv" />

            <ImageView
                android:id="@+id/status_box"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_router" />

            <ImageView
                android:id="@+id/status_ir"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ir" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- The TV's screen here, to choose from across the room -->
        <ImageButton
            android:id="@+id/mirror"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/listen_bg"
            android:contentDescription="@string/mirror_start"
            android:paddingBottom="4dp"
            android:src="@drawable/ic_mirror"
            android:stateListAnimator="@animator/key_press"
            android:tooltipText="@string/mirror_start" />

        <ImageButton
            android:id="@+id/listen"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/listen_bg"
            android:contentDescription="@string/listen_start"
            android:paddingBottom="4dp"
            android:src="@drawable/ic_headphones"
            android:stateListAnimator="@animator/key_press"
            android:tooltipText="@string/listen_start" />

        <com.couchtv.remote.PowerButton
            android:id="@+id/power"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/power_bg"
            android:contentDescription="@string/power"
            android:paddingBottom="4dp"
            android:src="@drawable/ic_power"
            android:stateListAnimator="@animator/key_press" />
    </LinearLayout>

    <!-- After Power: what's happening, and how long until the TV listens to its power button again -->
    <TextView
        android:id="@+id/power_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/update_bg"
        android:padding="12dp"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Shown when a newer build is on GitHub -->
    <LinearLayout
        android:id="@+id/update_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/update_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/update_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <Button
            android:id="@+id/update_now"
            style="@style/RemoteKey.Text"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/update"
            android:textColor="@color/good" />
    </LinearLayout>

    <com.couchtv.remote.PagerView
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- 0. Suggestions from the TV: popular films and top songs, to play there (left of the remote) -->
            <LinearLayout style="@style/Page">

                <com.couchtv.remote.SuggestionsView
                    android:id="@+id/suggestions"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- 1. Remote: search, the volume and brightness sliders one above the other, the D-pad as big as fits
                 with a key in each of its corners (full screen and the trackpad above, Back and play/pause below), and
                 the dock: the TV's streaming apps with their logos, a big Home in the middle. Height to spare is shared
                 out between them (RemoteColumn). Where the app opens. -->
            <com.couchtv.remote.RemoteColumn style="@style/Page">

                <!-- Search: the mic for voice search, or tap the bar to type -->
                <LinearLayout
                    android:id="@+id/search_bar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/search_bar_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_search" />

                    <TextView
                        android:id="@+id/search_hint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/search_hint"
                        android:textColor="@color/muted"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/voice_search"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/mic_bg"
                        android:contentDescription="@string/voice_search"
                        android:paddingStart="13dp"
                        android:paddingTop="11dp"
                        android:paddingEnd="13dp"
                        android:paddingBottom="15dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_mic"
                        android:stateListAnimator="@animator/key_press" />
                </LinearLayout>

                <!-- The TV's volume (tap the speaker to mute), and under it the brightness: drag along either. Each
                     bar sits 19 dp inside its view at the ends and 4 dp above and below (room to swell under the finger
                     and stretch past the ends, into the page's margins), so the bars line up with the search bar. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-19dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="-19dp"
                    android:orientation="vertical">

                    <com.couchtv.remote.LevelSlider
                        android:id="@+id/volume"
                        android:layout_width="match_parent"
                        android:layout_height="54dp" />

                    <com.couchtv.remote.LevelSlider
                        android:id="@+id/brightness"
                        android:layout_width="match_parent"
                        android:layout_height="54dp" />
                </LinearLayout>

                <!-- As big as the width allows, with a key in each corner round it -->
                <com.couchtv.remote.DpadView
                    android:id="@+id/dpad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="4dp" />

                <!-- The dock: two apps, Home, two apps -->
                <com.couchtv.remote.AppsGrid
                    android:id="@+id/apps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp" />

            </com.couchtv.remote.RemoteColumn>

            <!-- 2. A PC keyboard, laid along the screen's length (the app stays upright): turn the phone sideways to
                 type, with a button above the keys for this phone's own keyboard -->
            <LinearLayout
                style="@style/Page"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <com.couchtv.remote.KeyboardView
                    android:id="@+id/keyboard"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/keyboard" />
            </LinearLayout>
        </LinearLayout>
    </com.couchtv.remote.PagerView>

    <com.couchtv.remote.PageDots
        android:id="@+id/dots"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginBottom="4dp" />
</LinearLayout>

<!-- The screen mirror: the TV's screen, full screen in landscape, with a few keys at the side -->
<FrameLayout
    android:id="@+id/mirror_layer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:visibility="gone">

    <com.couchtv.remote.MirrorView
        android:id="@+id/mirror_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/mirror_title" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="8dp"
        android:background="@drawable/strip_bg"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="6dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/mirror_back"
            style="@style/StripKey"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <ImageButton
            android:id="@+id/mirror_home"
            style="@style/StripKey"
            android:contentDescription="@string/home"
            android:src="@drawable/ic_home" />

        <ImageButton
            android:id="@+id/mirror_volume_down"
            style="@style/StripKey"
            android:contentDescription="@string/volume_down"
            android:src="@drawable/ic_volume_down" />

        <ImageButton
            android:id="@+id/mirror_volume_up"
            style="@style/StripKey"
            android:contentDescription="@string/volume_up"
            android:src="@drawable/ic_volume_up" />

        <ImageButton
            android:id="@+id/mirror_keyboard"
            style="@style/StripKey"
            android:contentDescription="@string/keyboard"
            android:src="@drawable/ic_keyboard" />

        <ImageButton
            android:id="@+id/mirror_exit"
            style="@style/StripKey"
            android:contentDescription="@string/mirror_exit"
            android:src="@drawable/ic_close" />
    </LinearLayout>
</FrameLayout>

<!-- The trackpad, a dialog over the remote: it grows out of its key at the D-pad's top right -->
<FrameLayout
    android:id="@+id/trackpad_layer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:clickable="true"
    android:fitsSystemWindows="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/trackpad_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/card_bg"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_trackpad"
                android:tint="@color/muted" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/trackpad"
                android:textColor="@color/ink"
                android:textSize="18sp" />

            <ImageButton
                android:id="@+id/trackpad_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/status_bg"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <com.couchtv.remote.TrackpadView
            android:id="@+id/trackpad"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:layout_weight="1" />

        <!-- Hold one to drag with another finger on the pad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-5dp"
            android:layout_marginEnd="-5dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/left_click"
                style="@style/RemoteKey.Text"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:text="@string/left_click" />

            <Button
                android:id="@+id/right_click"
                style="@style/RemoteKey.Text"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:text="@string/right_click" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

<!-- Settings, a screen of its own over the remote (like a phone's Settings app) -->
<com.couchtv.remote.SettingsScreen
    android:id="@+id/settings_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />

<!-- Power with the TV on: a big countdown in the middle, as on the TV, with Cancel within easy reach -->
<FrameLayout
    android:id="@+id/power_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3000000"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/power_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/card_bg"
        android:clickable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="22dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <com.couchtv.remote.CountdownRing
            android:id="@+id/power_ring"
            android:layout_width="200dp"
            android:layout_height="200dp" />

        <TextView
            android:id="@+id/power_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/ink"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/power_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/power_cancel"
            style="@style/RemoteKey.Text"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:text="@string/power_cancel"
            android:textColor="@color/good"
            android:textSize="19sp" />

        <Button
            android:id="@+id/power_now"
            style="@style/RemoteKey.Text"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/power_now"
            android:textColor="@color/power" />
    </LinearLayout>
</FrameLayout>
</FrameLayout>
