<?xml version="1.0" encoding="utf-8"?>
<!-- Voice search, while the phone listens: a sheet from the bottom, rings round the mic swelling with your voice. Tap
     the mic to finish early, or to try again; tap outside (or Back) to stop. Hum a song, or type, instead. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sheet_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="10dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/handle_bg" />

    <!-- The mic stays its size; the rings round it swell with your voice inside their own square, so nothing moves -->
    <FrameLayout
        android:layout_width="176dp"
        android:layout_height="176dp">

        <com.couchtv.remote.VoiceRings
            android:id="@+id/voice_rings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/voice_mic"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:background="@drawable/mic_bg"
            android:contentDescription="@string/voice_mic"
            android:paddingStart="26dp"
            android:paddingTop="24dp"
            android:paddingEnd="26dp"
            android:paddingBottom="28dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mic"
            android:stateListAnimator="@animator/key_press" />
    </FrameLayout>

    <TextView
        android:id="@+id/voice_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/voice_starting"
        android:textColor="@color/ink"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/voice_heard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:minHeight="48dp"
        android:textColor="@color/muted"
        android:textSize="17sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/voice_hum"
            style="@style/Chip"
            android:drawableStart="@drawable/ic_music"
            android:text="@string/hum_a_song" />

        <TextView
            android:id="@+id/voice_type"
            style="@style/Chip"
            android:layout_marginStart="10dp"
            android:drawableStart="@drawable/ic_keyboard"
            android:text="@string/voice_type" />
    </LinearLayout>
</LinearLayout>
