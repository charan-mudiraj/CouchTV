<?xml version="1.0" encoding="utf-8"?>
<!-- The blue voice search key. A raised key, drawn like a real one: its side below, a light rim on top, a softly lit face. Pressed, it sinks (with animator/key_press). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
        <item android:top="4dp" android:bottom="3dp" android:left="2dp" android:right="2dp">
            <shape android:shape="oval">
                <solid android:color="@color/voice_edge" />
            </shape>
        </item>
        <item android:bottom="4dp" android:left="2dp" android:right="2dp">
            <shape android:shape="oval">
                <solid android:color="@color/voice_pressed_rim" />
            </shape>
        </item>
        <item android:top="1dp" android:bottom="4dp" android:left="2dp" android:right="2dp">
            <shape android:shape="oval">
                <gradient android:angle="270" android:startColor="@color/voice_pressed_top" android:endColor="@color/voice_pressed_bottom" />
            </shape>
        </item>
    </layer-list>
    </item>
    <item>
        <layer-list>
        <item android:top="4dp" android:bottom="0dp" android:left="2dp" android:right="2dp">
            <shape android:shape="oval">
                <solid android:color="@color/voice_edge" />
            </shape>
        </item>
        <item android:bottom="4dp" android:left="2dp" android:right="2dp">
            <shape android:shape="oval">
                <solid android:color="@color/voice_rim" />
            </shape>
        </item>
        <item android:top="1dp" android:bottom="4dp" android:left="2dp" android:right="2dp">
            <shape android:shape="oval">
                <gradient android:angle="270" android:startColor="@color/voice_top" android:endColor="@color/voice_bottom" />
            </shape>
        </item>
    </layer-list>
    </item>
</selector>
