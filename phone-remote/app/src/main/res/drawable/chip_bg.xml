<?xml version="1.0" encoding="utf-8"?>
<!-- An app tile: grey shades that android:backgroundTintMode="multiply" turns into the app's colour. A raised key, drawn like a real one: its side below, a light rim on top, a softly lit face. Pressed, it sinks (with animator/key_press). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
        <item android:top="4dp" android:bottom="3dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/tile_edge" />
                <corners android:radius="22dp" />
            </shape>
        </item>
        <item android:bottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/tile_pressed_rim" />
                <corners android:radius="22dp" />
            </shape>
        </item>
        <item android:top="1dp" android:bottom="4dp">
            <shape android:shape="rectangle">
                <gradient android:angle="270" android:startColor="@color/tile_pressed_top" android:endColor="@color/tile_pressed_bottom" />
                <corners android:radius="22dp" />
            </shape>
        </item>
    </layer-list>
    </item>
    <item>
        <layer-list>
        <item android:top="4dp" android:bottom="0dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/tile_edge" />
                <corners android:radius="22dp" />
            </shape>
        </item>
        <item android:bottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/tile_rim" />
                <corners android:radius="22dp" />
            </shape>
        </item>
        <item android:top="1dp" android:bottom="4dp">
            <shape android:shape="rectangle">
                <gradient android:angle="270" android:startColor="@color/tile_top" android:endColor="@color/tile_bottom" />
                <corners android:radius="22dp" />
            </shape>
        </item>
    </layer-list>
    </item>
</selector>
