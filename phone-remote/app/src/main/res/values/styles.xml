<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CouchRemote" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:colorAccent">@color/good</item>
    </style>

    <!--
        Keys look and move like real ones: raised, with their side showing below (key_bg and friends), and they sink
        3 dp while pressed (key_press). The bottom padding keeps icons and text in the middle of the key's face.
    -->

    <!-- An icon key. -->
    <style name="RemoteKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="android:background">@drawable/key_bg</item>
        <item name="android:scaleType">center</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:stateListAnimator">@animator/key_press</item>
    </style>

    <!-- A text key. -->
    <style name="RemoteKey.Text" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/key_bg</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:stateListAnimator">@animator/key_press</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:maxLines">2</item>
    </style>

    <!-- A key on the screen mirror's strip. -->
    <style name="StripKey">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:layout_marginBottom">3dp</item>
        <item name="android:background">@drawable/key_bg</item>
        <item name="android:scaleType">center</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:stateListAnimator">@animator/key_press</item>
    </style>

    <!-- A sheet from the bottom of the screen (voice search): floats over the app, which dims behind it. -->
    <style name="Sheet" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:windowAnimationStyle">@style/SheetMotion</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
    </style>

    <style name="SheetMotion">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>

    <!-- The search page: the whole screen, over the remote. -->
    <style name="SearchScreen" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:colorAccent">@color/voice_rim</item>
        <item name="android:windowAnimationStyle">@style/ScreenMotion</item>
    </style>

    <style name="ScreenMotion">
        <item name="android:windowEnterAnimation">@anim/screen_in</item>
        <item name="android:windowExitAnimation">@anim/screen_out</item>
    </style>

    <!-- A chip under the voice search's mic, and on the search page. -->
    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">@color/ink</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- The name at the top of a page. -->
    <style name="PageTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- A page's one action, top right (the pointer's look, typing with the phone's keyboard): a quiet pill. -->
    <style name="PageAction">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_gravity">end</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/status_bg</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/good</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- One page: as wide as the screen (the pager sets it), never scrolling. -->
    <style name="Page">
        <item name="android:layout_width">360dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="Section">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
