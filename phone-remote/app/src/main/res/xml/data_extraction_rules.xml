<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: keys for the TV and the receiver box stay on this phone, out of backups and transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="pairing.xml" />
        <exclude domain="sharedpref" path="board.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pairing.xml" />
        <exclude domain="sharedpref" path="board.xml" />
    </device-transfer>
</data-extraction-rules>
